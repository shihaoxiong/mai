{
  "mcpServers": {
    "terminal": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-terminal", "--project", "./"],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin",
        "HOME": "/Users/user"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./"],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin",
        "HOME": "/Users/user"
      }
    },
    "playwriter": {
      "command": "npx",
      "args": ["playwriter@latest"],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin"
      }
    },
    "websearch": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-puppeteer"],
      "env": {
        "PATH": "/usr/local/bin:/usr/bin"
      }
    }
  }
}
